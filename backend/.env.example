# Copy this file to .env and fill in real values. Never commit .env.

# Supabase: Project Settings -> Database -> Connection string -> URI
# Use the "Transaction" pooler connection (port 6543) for FastAPI running
# as multiple worker processes; use the direct connection (port 5432) if
# you're just running Alembic migrations locally.
DATABASE_URL=postgresql://postgres:[password]@[project-ref].pooler.supabase.com:6543/postgres

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# Supabase Storage or Cloudflare R2 (Step 6)
# From: Supabase Dashboard -> your project -> Storage -> Settings -> S3 Connection
STORAGE_ENDPOINT_URL=https://[project-ref].storage.supabase.co/storage/v1/s3
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=infinix-assets
STORAGE_REGION=ap-south-1
# Public bucket base URL, used to build image links returned to the frontend:
# https://[project-ref].supabase.co/storage/v1/object/public/infinix-assets
STORAGE_PUBLIC_BASE_URL=https://[project-ref].supabase.co/storage/v1/object/public/infinix-assets

REDIS_URL=redis://localhost:6379/0

FRONTEND_ORIGIN=http://localhost:3000
ENVIRONMENT=development
