# Copy this file to .env.local and adjust for your environment.

# Server-side only (Server Components fetching public catalog data during
# SSR — see lib/api.ts). Never exposed to the browser bundle.
API_BASE_URL=http://localhost:8000

# Same backend, but exposed to the BROWSER (login, cart, checkout — see
# lib/clientApi.ts). Must use the NEXT_PUBLIC_ prefix or Next.js won't
# include it in the client bundle. In production this should be your
# public API domain, e.g. https://api.infinix.example.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
